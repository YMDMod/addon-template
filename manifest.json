{
  "id": "example",
  "name": "Пример аддона",
  "version": "1.2.0",
  "description": "Шаблон для своего аддона: показывает возможности API на вкладке «Пример» страницы мода.",
  "modVersions": [">=0.2.0 <1.0.0"],
  "dependencies": { "notifications": ">=0.3.0" },
  "settings": [
    { "key": "greeting", "type": "string", "label": "Текст приветствия", "default": "Привет от примера!" },
    { "key": "markNav", "type": "boolean", "label": "Отмечать пункты навигации точкой", "default": true },
    { "key": "dotSize", "type": "number", "label": "Размер точки, px", "default": 6 },
    {
      "key": "dotColor",
      "type": "select",
      "label": "Цвет точки",
      "default": "accent",
      "options": [
        { "value": "accent", "label": "Жёлтый" },
        { "value": "green", "label": "Зелёный" },
        { "value": "red", "label": "Красный" }
      ]
    }
  ]
}
